generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  emailVerified  DateTime?
  password       String
  phone          String?
  secondaryPhone String?
  birthDate      DateTime?
  role           String          @default("CLIENT")
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  appointments   Appointment[]
  passwordResets PasswordReset[]
  reviews        Review[]
  blockedTimes   BlockedTime[]
  couponUsages   CouponUsage[]
  notifications  Notification[]

  @@map("users")
}

model PasswordReset {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@map("password_resets")
}

model Service {
  id                  String               @id @default(cuid())
  name                String
  description         String
  price               Float
  duration            Int
  active              Boolean              @default(true)
  featured            Boolean              @default(false)
  images              String[]             @default([])
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  appointments        Appointment[]
  reviews             Review[]
  comboServices       ComboService[]
  staffServices       StaffService[] // ✅ NOVO - Serviços executados por funcionários
  appointmentServices AppointmentService[]

  @@map("services")
}

model ServiceCombo {
  id              String   @id @default(cuid())
  name            String
  description     String?
  active          Boolean  @default(true)
  featured        Boolean  @default(false)
  discountPercent Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  services      ComboService[]
  appointments  Appointment[]
  staffServices StaffService[] // ✅ NOVO - Combos executados por funcionários

  @@map("service_combos")
}

model ComboService {
  id        String @id @default(cuid())
  comboId   String
  serviceId String

  combo   ServiceCombo @relation(fields: [comboId], references: [id], onDelete: Cascade)
  service Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([comboId, serviceId])
  @@map("combo_services")
}

model Appointment {
  id              String    @id @default(cuid())
  date            DateTime
  time            String
  status          String    @default("PENDING")
  notes           String?
  internalNotes   String?
  justification   String?
  justifiedAt     DateTime?
  paymentMethod   String?
  couponId        String?
  discountAmount  Float     @default(0)
  finalPrice      Float?
  cancelReason    String?
  rescheduledFrom String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  userId          String
  serviceId       String?
  comboId         String?

  user                User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  service             Service?                   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  combo               ServiceCombo?              @relation(fields: [comboId], references: [id])
  coupon              Coupon?                    @relation(fields: [couponId], references: [id])
  statusHistory       AppointmentStatusHistory[]
  couponUsages        CouponUsage[]
  review              Review?
  staffServices       StaffService[]             @relation("StaffServiceAppointment")
  appointmentServices AppointmentService[]

  @@index([userId])
  @@index([serviceId])
  @@index([comboId])
  @@index([date])
  @@index([couponId])
  @@map("appointments")
}

model AppointmentService {
  id            String   @id @default(cuid())
  appointmentId String
  serviceId     String
  quantity      Int      @default(1)
  price         Float
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([appointmentId, serviceId])
  @@index([appointmentId])
  @@index([serviceId])
  @@map("appointment_services")
}

model AppointmentStatusHistory {
  id            String      @id @default(cuid())
  appointmentId String
  status        String
  changedBy     String?
  changedAt     DateTime    @default(now())
  notes         String?
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("appointment_status_history")
}

model AvailableSlot {
  id        String   @id @default(cuid())
  dayOfWeek Int
  timeSlot  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dayOfWeek, timeSlot])
  @@map("available_slots")
}

model Coupon {
  id                 String        @id @default(cuid())
  code               String        @unique
  description        String
  discountType       String
  discountValue      Float
  minValue           Float?
  maxUses            Int?
  usedCount          Int           @default(0)
  validFrom          DateTime
  validUntil         DateTime
  active             Boolean       @default(true)
  applicableServices String[]      @default([])
  perUserLimit       Boolean       @default(false)
  daysOfWeek         Int[]         @default([])
  timeStart          String?
  timeEnd            String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  appointments       Appointment[]
  usageHistory       CouponUsage[]

  @@map("coupons")
}

model CouponUsage {
  id             String      @id @default(cuid())
  couponId       String
  coupon         Coupon      @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointmentId  String
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  discountAmount Float
  usedAt         DateTime    @default(now())

  @@index([couponId])
  @@index([userId])
  @@index([appointmentId])
  @@map("coupon_usage")
}

model Review {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointmentId  String?      @unique
  appointment    Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId      String?
  service        Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  rating         Int
  comment        String?
  images         String[]     @default([])
  status         String       @default("PENDING")
  featured       Boolean      @default(false)
  moderatedBy    String?
  moderatedAt    DateTime?
  moderationNote String?
  token          String?      @unique
  tokenUsed      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId])
  @@index([appointmentId])
  @@index([serviceId])
  @@index([status])
  @@index([featured])
  @@index([rating])
  @@index([token])
  @@map("reviews")
}

model BlockedTime {
  id          String          @id @default(cuid())
  type        BlockedTimeType
  date        DateTime?
  startTime   String?
  endTime     String?
  dayOfWeek   Int?
  isRecurring Boolean         @default(false)
  reason      String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  createdBy   String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  creator     User            @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([dayOfWeek])
  @@index([isRecurring])
  @@index([type])
  @@map("blocked_times")
}

enum BlockedTimeType {
  LUNCH_BREAK
  DAY_OFF
  HOLIDAY
  VACATION
  MAINTENANCE
  SPECIAL_EVENT
  OTHER
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String   @db.Text
  type      String   @default("INFO")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================
// ✅ NOVO: SISTEMA DE COMANDA/FUNCIONÁRIOS
// ============================================

// FUNCIONÁRIOS (STAFF)
model Staff {
  id    String  @id @default(cuid())
  name  String
  email String? @unique
  phone String?
  photo String? // URL da foto no Cloudinary
  cpf   String? @unique

  // Profissional
  specialties       String[] // ["Corte", "Coloração", "Manicure"]
  commissionPercent Float    @default(30) // % de comissão (30%)

  // Status
  active   Boolean  @default(true)
  hireDate DateTime @default(now())

  // Horários de trabalho (opcional)
  workSchedule Json? // { "seg": "9-18", "ter": "9-18", ... }

  // Relações
  services       StaffService[]
  monthlyReports StaffMonthlyReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([name])
  @@map("staff")
}

// SERVIÇOS EXECUTADOS (COMANDA)
model StaffService {
  id            String  @id @default(cuid())
  appointmentId String?

  appointment Appointment? @relation("StaffServiceAppointment", fields: [appointmentId], references: [id], onDelete: SetNull)

  // Quem fez
  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  // O que foi feito
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  comboId String?
  combo   ServiceCombo? @relation(fields: [comboId], references: [id], onDelete: SetNull)

  // Para quem (cliente)
  clientName  String
  clientPhone String?

  // Valores
  serviceValue    Float // Valor do serviço
  commissionValue Float // Valor da comissão calculada

  // Quando
  executedAt DateTime @default(now()) // Data/hora que o serviço foi executado
  duration   Int? // Duração em minutos

  // Pagamento
  paymentMethod  PaymentMethod @default(DINHEIRO)
  commissionPaid Boolean       @default(false) // Comissão foi paga ao funcionário?
  paidAt         DateTime?

  // Observações
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId, executedAt])
  @@index([executedAt])
  @@index([commissionPaid])
  @@map("staff_services")
}

// RELATÓRIOS MENSAIS CONSOLIDADOS
model StaffMonthlyReport {
  id String @id @default(cuid())

  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  // Período
  year  Int
  month Int // 1-12

  // Totais
  totalServices   Int   @default(0)
  totalRevenue    Float @default(0) // Total faturado
  totalCommission Float @default(0) // Total de comissão

  // Pagamento
  paid         Boolean   @default(false)
  paidAt       DateTime?
  paymentNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, year, month])
  @@index([year, month])
  @@index([paid])
  @@map("staff_monthly_reports")
}

// ENUM para formas de pagamento
enum PaymentMethod {
  DINHEIRO
  CARTAO_DEBITO
  CARTAO_CREDITO
  PIX
  TRANSFERENCIA
}

model FinancialGoal {
  id        String   @id @default(cuid())
  goal      Float
  month     Int
  year      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([month, year])
  @@map("financial_goals")
}
