generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  emailVerified  DateTime?
  password       String
  phone          String?
  birthDate      DateTime?
  role           String          @default("CLIENT")
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  appointments   Appointment[]
  passwordResets PasswordReset[]
  reviews        Review[]

  @@map("users")
}

model PasswordReset {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@map("password_resets")
}

model Service {
  id           String        @id @default(cuid())
  name         String
  description  String
  price        Float
  duration     Int
  active       Boolean       @default(true)
  images       String[]      @default([])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]

  @@map("services")
}

model Appointment {
  id              String                     @id @default(cuid())
  date            DateTime
  time            String
  status          String                     @default("PENDING")
  notes           String?
  internalNotes   String? // Notas internas do admin
  justification   String?
  justifiedAt     DateTime?
  paymentMethod   String?
  couponId        String?
  discountAmount  Float                      @default(0)
  finalPrice      Float? // Preço final após desconto
  cancelReason    String?
  rescheduledFrom String? // ID do agendamento anterior
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  userId          String
  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service                    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  coupon          Coupon?                    @relation(fields: [couponId], references: [id])
  statusHistory   AppointmentStatusHistory[]

  @@index([userId])
  @@index([serviceId])
  @@index([date])
  @@map("appointments")
}

model AppointmentStatusHistory {
  id            String      @id @default(cuid())
  appointmentId String
  status        String
  changedBy     String?
  changedAt     DateTime    @default(now())
  notes         String?
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("appointment_status_history")
}

model AvailableSlot {
  id        String   @id @default(cuid())
  dayOfWeek Int
  timeSlot  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dayOfWeek, timeSlot])
  @@map("available_slots")
}

model Coupon {
  id                 String        @id @default(cuid())
  code               String        @unique
  description        String
  discountType       String // "PERCENTAGE" ou "FIXED"
  discountValue      Float
  minValue           Float?
  maxUses            Int?
  usedCount          Int           @default(0)
  validFrom          DateTime
  validUntil         DateTime
  active             Boolean       @default(true)
  applicableServices String[]      @default([])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  appointments       Appointment[]

  @@map("coupons")
}

model Review {
  id            String   @id @default(cuid())
  userId        String
  appointmentId String?  @unique
  rating        Int
  comment       String?
  images        String[] @default([])
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])

  @@map("reviews")
}

model BlockedTime {
  id           String   @id @default(cuid())
  startDate    DateTime
  endDate      DateTime
  startTime    String?
  endTime      String?
  reason       String
  isRecurring  Boolean  @default(false)
  recurringDay Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("blocked_times")
}
