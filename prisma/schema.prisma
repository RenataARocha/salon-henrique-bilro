generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  emailVerified  DateTime?
  password       String
  phone          String?
  birthDate      DateTime?
  role           String          @default("CLIENT")
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  appointments   Appointment[]
  passwordResets PasswordReset[]
  reviews        Review[]
  blockedTimes   BlockedTime[]
  couponUsages   CouponUsage[] // 🆕 ADICIONADO

  @@map("users")
}

model PasswordReset {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@map("password_resets")
}

model Service {
  id           String        @id @default(cuid())
  name         String
  description  String
  price        Float
  duration     Int
  active       Boolean       @default(true)
  images       String[]      @default([])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]

  @@map("services")
}

model Appointment {
  id              String                     @id @default(cuid())
  date            DateTime
  time            String
  status          String                     @default("PENDING")
  notes           String?
  internalNotes   String?
  justification   String?
  justifiedAt     DateTime?
  paymentMethod   String?
  couponId        String?
  discountAmount  Float                      @default(0)
  finalPrice      Float?
  cancelReason    String?
  rescheduledFrom String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  userId          String
  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service                    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  coupon          Coupon?                    @relation(fields: [couponId], references: [id])
  statusHistory   AppointmentStatusHistory[]
  couponUsages    CouponUsage[] // 🆕 ADICIONADO

  @@index([userId])
  @@index([serviceId])
  @@index([date])
  @@index([couponId])
  @@map("appointments")
}

model AppointmentStatusHistory {
  id            String      @id @default(cuid())
  appointmentId String
  status        String
  changedBy     String?
  changedAt     DateTime    @default(now())
  notes         String?
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("appointment_status_history")
}

model AvailableSlot {
  id        String   @id @default(cuid())
  dayOfWeek Int
  timeSlot  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dayOfWeek, timeSlot])
  @@map("available_slots")
}

// 🆕 MODELO ATUALIZADO COM NOVAS FUNCIONALIDADES
model Coupon {
  id                 String   @id @default(cuid())
  code               String   @unique
  description        String
  discountType       String // "PERCENTAGE" ou "FIXED"
  discountValue      Float
  minValue           Float?
  maxUses            Int?
  usedCount          Int      @default(0)
  validFrom          DateTime
  validUntil         DateTime
  active             Boolean  @default(true)
  applicableServices String[] @default([])

  // 🆕 Novas funcionalidades
  perUserLimit Boolean @default(false) // Um uso por cliente
  daysOfWeek   Int[]   @default([]) // [0,1,2,3,4,5,6]
  timeStart    String? // "09:00"
  timeEnd      String? // "18:00"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]
  usageHistory CouponUsage[] // 🆕 ADICIONADO

  @@map("coupons")
}

// 🆕 NOVO MODELO - Histórico de uso de cupons
model CouponUsage {
  id             String      @id @default(cuid())
  couponId       String
  coupon         Coupon      @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointmentId  String
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  discountAmount Float
  usedAt         DateTime    @default(now())

  @@index([couponId])
  @@index([userId])
  @@index([appointmentId])
  @@map("coupon_usage")
}

model Review {
  id            String   @id @default(cuid())
  userId        String
  appointmentId String?  @unique
  rating        Int
  comment       String?
  images        String[] @default([])
  status        String   @default("PENDING")
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])

  @@map("reviews")
}

model BlockedTime {
  id String @id @default(cuid())

  // Tipo de bloqueio
  type BlockedTimeType

  // Para bloqueios pontuais (eventos, feriados)
  date      DateTime?
  startTime String?
  endTime   String?

  // Para bloqueios recorrentes (ex: toda segunda-feira)
  dayOfWeek   Int?
  isRecurring Boolean @default(false)

  // Informações
  reason      String
  description String?

  // Para controlar período de validade
  startDate DateTime?
  endDate   DateTime?

  // Metadata
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relação
  creator User @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([dayOfWeek])
  @@index([isRecurring])
  @@index([type])
  @@map("blocked_times")
}

enum BlockedTimeType {
  LUNCH_BREAK
  DAY_OFF
  HOLIDAY
  VACATION
  MAINTENANCE
  SPECIAL_EVENT
  OTHER
}
