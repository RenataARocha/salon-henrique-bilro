generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  emailVerified  DateTime?
  password       String
  phone          String?
  birthDate      DateTime?
  role           String          @default("CLIENT")
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  appointments   Appointment[]
  passwordResets PasswordReset[]
  reviews        Review[]
  blockedTimes   BlockedTime[] // 🆕 ADICIONADO

  @@map("users")
}

model PasswordReset {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@map("password_resets")
}

model Service {
  id           String        @id @default(cuid())
  name         String
  description  String
  price        Float
  duration     Int
  active       Boolean       @default(true)
  images       String[]      @default([])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]

  @@map("services")
}

model Appointment {
  id              String                     @id @default(cuid())
  date            DateTime
  time            String
  status          String                     @default("PENDING")
  notes           String?
  internalNotes   String?
  justification   String?
  justifiedAt     DateTime?
  paymentMethod   String?
  couponId        String?
  discountAmount  Float                      @default(0)
  finalPrice      Float?
  cancelReason    String?
  rescheduledFrom String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  userId          String
  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service                    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  coupon          Coupon?                    @relation(fields: [couponId], references: [id])
  statusHistory   AppointmentStatusHistory[]

  @@index([userId])
  @@index([serviceId])
  @@index([date])
  @@map("appointments")
}

model AppointmentStatusHistory {
  id            String      @id @default(cuid())
  appointmentId String
  status        String
  changedBy     String?
  changedAt     DateTime    @default(now())
  notes         String?
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("appointment_status_history")
}

model AvailableSlot {
  id        String   @id @default(cuid())
  dayOfWeek Int
  timeSlot  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dayOfWeek, timeSlot])
  @@map("available_slots")
}

model Coupon {
  id                 String        @id @default(cuid())
  code               String        @unique
  description        String
  discountType       String
  discountValue      Float
  minValue           Float?
  maxUses            Int?
  usedCount          Int           @default(0)
  validFrom          DateTime
  validUntil         DateTime
  active             Boolean       @default(true)
  applicableServices String[]      @default([])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  appointments       Appointment[]

  @@map("coupons")
}

model Review {
  id            String   @id @default(cuid())
  userId        String
  appointmentId String?  @unique
  rating        Int
  comment       String?
  images        String[] @default([])
  status        String   @default("PENDING")
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])

  @@map("reviews")
}

// 🆕 MODELO ATUALIZADO E COMPLETO
model BlockedTime {
  id String @id @default(cuid())

  // Tipo de bloqueio
  type BlockedTimeType

  // Para bloqueios pontuais (eventos, feriados)
  date      DateTime?
  startTime String?
  endTime   String?

  // Para bloqueios recorrentes (ex: toda segunda-feira)
  dayOfWeek   Int? // 0-6 (Domingo a Sábado)
  isRecurring Boolean @default(false)

  // Informações
  reason      String
  description String?

  // Para controlar período de validade
  startDate DateTime? // Início do período
  endDate   DateTime? // Fim do período

  // Metadata
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relação
  creator User @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([dayOfWeek])
  @@index([isRecurring])
  @@index([type])
  @@map("blocked_times")
}

// 🆕 ENUM DE TIPOS DE BLOQUEIO
enum BlockedTimeType {
  LUNCH_BREAK // Horário de almoço
  DAY_OFF // Folga/Dia de descanso
  HOLIDAY // Feriado
  VACATION // Férias
  MAINTENANCE // Manutenção do salão
  SPECIAL_EVENT // Evento especial (curso, viagem)
  OTHER // Outro motivo
}
